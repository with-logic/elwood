{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "elwood-review": {
      "description": "Applies one Elwood review lens, or merges reports; scripts/review/run.sh owns the fan-out",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "deny",
        "skill": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "lsp": "deny"
      }
    }
  },
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "tool_call": true
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "preserve_recent_tokens": 16384,
    "reserved": 20000
  }
}
