{
  "name": "elwood",
  "version": "0.0.0",
  "private": true,
  "description": "Spec-driven TypeScript project.",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "PRD.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "elwood": "./dist/cli/entry.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --no-warnings src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepare": "npm run build",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:lines": "node --no-warnings scripts/check-lines.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm run check:lines && npm test",
    "check:all": "npm run check && npm run test:e2e",
    "test:e2e": "exec node --no-warnings --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/app/**' --test-coverage-exclude='tests/**' --test-timeout=240000 --test-concurrency=1 --test tests/e2e/*.e2e.ts",
    "dev:app": "exec node --no-warnings src/app/dev.ts",
    "dev:web": "exec node --no-warnings scripts/dev-web.ts",
    "example:minimal": "exec node --no-warnings scripts/run-example.ts examples/minimal.ts",
    "example:stream": "exec node --no-warnings scripts/run-example.ts examples/stream.ts",
    "example:full": "exec node --no-warnings scripts/run-example.ts examples/full.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  }
}
