{
  "name": "@with-logic/elwood",
  "version": "0.1.3",
  "description": "Control interactive agentic coding CLIs (Claude Code, Codex) through real terminal sessions: typed hooks, a unified activity stream, resumable sessions, and a headless CLI.",
  "license": "MIT",
  "author": "Logic App, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/with-logic/elwood.git"
  },
  "homepage": "https://elwood.bot",
  "bugs": {
    "url": "https://github.com/with-logic/elwood/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "pty",
    "terminal",
    "hooks",
    "cli",
    "automation",
    "llm"
  ],
  "type": "module",
  "files": [
    "dist",
    "docs/**/*.md",
    "prd/**/*.md",
    "examples/*.ts",
    "examples/README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "elwood": "./dist/cli/entry.js"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:lines": "node --no-warnings scripts/check-lines.ts",
    "check": "npm run build && npm run typecheck && npm run lint && npm run check:lines && npm test",
    "check:all": "npm run check && npm run test:e2e",
    "test:e2e": "exec node --no-warnings --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='tests/**' --test-timeout=240000 --test-concurrency=1 --test tests/e2e/*.e2e.ts",
    "dev:app": "exec node --no-warnings dev/dev.ts",
    "dev:web": "exec node --no-warnings scripts/supervise.ts dev/web/dev.ts",
    "example:minimal": "exec node --no-warnings scripts/supervise.ts examples/minimal.ts",
    "example:stream": "exec node --no-warnings scripts/supervise.ts examples/stream.ts",
    "example:full": "exec node --no-warnings scripts/supervise.ts examples/full.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
