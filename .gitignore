node_modules/
dist/
coverage/
.DS_Store
*.log

# Session state written by local dev runs and tests that start in this checkout.
.elwood/
.tmp-elwood-*

# Local AI assistant runtime files and planning scratchpads.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/review/
!.claude/skills/review-*/
tickets/

# This repository is spec-first; the specification must be tracked even if a
# global gitignore excludes files named PRD.md. The spec now lives in prd/,
# but keep the negation in case a stray global rule matches those names too.
!PRD.md
!prd/
!prd/**

# Ephemeral code-review artifacts (regenerated each run).
REVIEW.md
.worktrees/
VALIDATION.md
scripts/review/discussion.txt
scripts/review/**/__pycache__/

# Site: generated animation masters and internal review media live outside the
# repository. `site/assets/game/` (the runtime sprite sheets) IS committed.
site/assets/production/
site/docs/reviews/
site/**/__pycache__/
site/assets/frame.png

# Cached CI reviewer binaries.
.review-tools/
